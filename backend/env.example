# Database (docker compose -f docker-compose.db.yml up -d)
DATABASE_URL=


# DeepSeek API
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=

# WeChat Database Path
WECHAT_DB_PATH=

# WeChat Voice File Path
VOICE_FILE_PATH=

# Server
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true
APP_ENV=dev

# MCP Streamable HTTP (APP_ENV=prod needs MCP_API_KEY or MCP_CLIENTS)
# Legacy shared key: client_id=default, read scope only
MCP_API_KEY=
# One key per client, scopes granted separately (read / ingest). Holding read does not allow writes.
# MCP_CLIENTS=[{"client_id":"cs-agent","api_key":"<long random key>","scopes":["read","ingest"]}]
MCP_CLIENTS=
# Scenarios accepted by ingest_samples
MCP_INGEST_SCENARIOS=sales_chat,badcase

# Volcengine TOS (Object Storage)
TOS_ACCESS_KEY=
TOS_SECRET_KEY=
TOS_ENDPOINT=
TOS_REGION=cn-beijing
TOS_BUCKET=wx-bucket

# Cloud Embedding API (DashScope)
ARK_API_KEY=sk-
ARK_EMBEDDING_MODEL=
ARK_BASE_URL=

